# Robinhood Chain network the site connects to: "testnet" (default) or "mainnet".
NEXT_PUBLIC_ROBINHOOD_NETWORK=testnet

# Address of the deployed HOODS contract on that network. Leave empty until the
# contract is deployed; the site's Contract link stays hidden while it is unset.
NEXT_PUBLIC_HOODS_CONTRACT_ADDRESS=

# Address of the HOODS testnet contract the /testnet tools page works on. Needed
# only when the site is on mainnet; on testnet the page uses the address above.
NEXT_PUBLIC_HOODS_TESTNET_CONTRACT_ADDRESS=
